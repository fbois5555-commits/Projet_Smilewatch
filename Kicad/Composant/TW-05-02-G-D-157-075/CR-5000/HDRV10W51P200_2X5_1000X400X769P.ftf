            (pt 0 0)
            (width 135000)
            (height 135000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack c135h90
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 45000
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c135))
          (noconnect (pad c135))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c135))
          (noconnect (pad c135))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c135))
          (noconnect (pad c135))
        )
        (padSet (footLayer Inner)
          (clearance (pad c135))
          (connect (pad c135))
          (noconnect (pad c135))
        )
        (padSet (footLayer Bottom)
          (connect (pad c135))
          (noconnect (pad c135))
        )
